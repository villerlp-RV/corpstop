{
  "name": "ServiceLine",
  "type": "object",
  "description": "One customer service line in a WaterSystem, with its material and how it was identified. Shared with the owner's team; personal (team_id null) records are private to their creator.",
  "properties": {
    "team_id": {
      "type": "string",
      "title": "Team ID",
      "description": "Team that owns this record. Null for a personal record, visible only to its creator. Set on create; only server functions move records between teams.",
      "rls": {
        "create": true,
        "update": false
      }
    },
    "system_id": {
      "type": "string",
      "title": "Water System ID"
    },
    "address": {
      "type": "string",
      "title": "Service Address",
      "minLength": 1
    },
    "material": {
      "type": "string",
      "enum": [
        "lead",
        "grr",
        "unknown",
        "non_lead"
      ],
      "default": "unknown",
      "title": "Material"
    },
    "identification_method": {
      "type": "string",
      "title": "How Identified",
      "description": "e.g. Tap card, Visual (curb stop), Potholing, Customer photo"
    },
    "verified_date": {
      "type": "string",
      "format": "date",
      "title": "Verified Date"
    },
    "verified_by": {
      "type": "string",
      "title": "Verified By"
    },
    "is_example": {
      "type": "boolean",
      "title": "Example Data",
      "default": false
    }
  },
  "required": [
    "system_id",
    "address"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.team_id": "{{user.data.team_id}}"
            },
            {
              "data.team_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.team_id": null
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.team_id": "{{user.data.team_id}}"
            },
            {
              "data.team_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.team_id": "{{user.data.team_id}}"
            },
            {
              "data.team_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.team_id": "{{user.data.team_id}}"
            },
            {
              "data.team_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    }
  }
}
