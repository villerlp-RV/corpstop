{
  "name": "ServiceLine",
  "type": "object",
  "description": "One customer service line in a WaterSystem, with its material and how it was identified. Shared with the owner's team; personal (team_id null) records are private to their creator.",
  "properties": {
    "team_id": {
      "type": "string",
      "title": "Team ID",
      "description": "Team that owns this record. Null for a personal record, visible only to its creator. Set on create; only server functions move records between teams.",
      "rls": {
        "create": true,
        "update": false
      }
    },
    "system_id": {
      "type": "string",
      "title": "Water System ID",
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "address": {
      "type": "string",
      "title": "Service Address",
      "minLength": 1,
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name",
      "description": "Person or account at the service address, for notices.",
      "maxLength": 120,
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email",
      "description": "Where emailed annual notices for this line go.",
      "maxLength": 200,
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "material": {
      "type": "string",
      "enum": [
        "lead",
        "grr",
        "unknown",
        "non_lead"
      ],
      "default": "unknown",
      "title": "Material"
    },
    "material_type": {
      "type": "string",
      "enum": ["copper", "plastic", "galvanized", "iron", "brass", "other"],
      "title": "Non-lead Material",
      "description": "Specific material of a non-lead line or portion (40 CFR 141.84(a)(3)(iii) allows it in place of Non-Lead). galvanized = galvanized never downstream of lead."
    },
    "ownership": {
      "type": "string",
      "enum": ["single", "split"],
      "default": "single",
      "title": "Ownership",
      "description": "split when the system and the customer each own a portion; each portion is then categorized (141.84(a)(3))."
    },
    "system_side": {
      "type": "string",
      "enum": ["lead", "grr", "unknown", "non_lead"],
      "title": "System-side Material"
    },
    "customer_side": {
      "type": "string",
      "enum": ["lead", "grr", "unknown", "non_lead"],
      "title": "Customer-side Material"
    },
    "connector": {
      "type": "string",
      "enum": ["lead", "non_lead", "unknown", "none"],
      "title": "Connector",
      "description": "Lead connector (gooseneck, pigtail) category per 141.84(a)(2)(ii); none = no connector present."
    },
    "identification_method": {
      "type": "string",
      "title": "How Identified",
      "description": "e.g. Tap card, Visual (curb stop), Potholing, Customer photo"
    },
    "verified_date": {
      "type": "string",
      "format": "date",
      "title": "Verified Date"
    },
    "verified_by": {
      "type": "string",
      "title": "Verified By"
    },
    "is_example": {
      "type": "boolean",
      "title": "Example Data",
      "default": false
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To (User ID)",
      "description": "Team member who should visit this line.",
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "assigned_to_name": {
      "type": "string",
      "title": "Assigned To",
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "assigned_by_name": {
      "type": "string",
      "title": "Assigned By",
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time",
      "title": "Assigned At",
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "assignment_status": {
      "type": "string",
      "enum": [
        "open",
        "done"
      ],
      "title": "Field Assignment Status",
      "description": "open = waiting for a field visit; done = recorded in the field. Empty when never assigned."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Recorded In Field At"
    },
    "field_notes": {
      "type": "string",
      "title": "Field Notes",
      "maxLength": 1000
    },
    "photo_uri": {
      "type": "string",
      "title": "Photo (private file URI)",
      "description": "Deprecated: the first photo of early records. New photos go in photo_uris."
    },
    "photo_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Photos (private file URIs)",
      "description": "From UploadPrivateFile; view with CreateFileSignedUrl. Newest last."
    },
    "attachments": {
      "type": "array",
      "title": "Attachments",
      "description": "Files attached to the line (tap cards, permits, invoices, records). Private file URIs from UploadPrivateFile; open with CreateFileSignedUrl.",
      "items": {
        "type": "object",
        "properties": {
          "uri": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "size": { "type": "number" },
          "added_at": { "type": "string" },
          "added_by": { "type": "string" }
        },
        "required": ["uri", "name"]
      }
    }
  },
  "required": [
    "system_id",
    "address"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.team_id": "{{user.data.team_id}}"
            },
            {
              "data.team_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "$and": [
                {
                  "data.team_id": "{{user.data.team_id}}"
                },
                {
                  "data.team_id": {
                    "$ne": null
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.team_role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "data.perm_write": true
                  }
                },
                {
                  "user_condition": {
                    "data.perm_edit": true
                  }
                }
              ]
            }
          ]
        },
        {
          "data.team_id": null
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$and": [
                {
                  "data.team_id": "{{user.data.team_id}}"
                },
                {
                  "data.team_id": {
                    "$ne": null
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.team_role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "data.perm_edit": true
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.perm_write": true
                      }
                    },
                    {
                      "data.assigned_to": "{{user.id}}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "$and": [
                {
                  "data.team_id": "{{user.data.team_id}}"
                },
                {
                  "data.team_id": {
                    "$ne": null
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.team_role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "data.perm_edit": true
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    }
  }
}
