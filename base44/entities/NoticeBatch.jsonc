{
  "name": "NoticeBatch",
  "type": "object",
  "description": "A batch of annual lead service line notices queued for print and mail. Shared with the owner's team; personal (team_id null) records are private to their creator.",
  "properties": {
    "team_id": {
      "type": "string",
      "title": "Team ID",
      "description": "Team that owns this record. Null for a personal record, visible only to its creator. Set on create; only server functions move records between teams.",
      "rls": {
        "create": true,
        "update": false
      }
    },
    "system_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Water Systems"
    },
    "letter_count": {
      "type": "number",
      "title": "Letters"
    },
    "queued_date": {
      "type": "string",
      "format": "date",
      "title": "Queued Date"
    }
  },
  "required": [
    "system_ids",
    "letter_count",
    "queued_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.team_id": "{{user.data.team_id}}"
            },
            {
              "data.team_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.team_id": null
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.team_id": "{{user.data.team_id}}"
            },
            {
              "data.team_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.team_id": "{{user.data.team_id}}"
            },
            {
              "data.team_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.team_id": "{{user.data.team_id}}"
            },
            {
              "data.team_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    }
  }
}
