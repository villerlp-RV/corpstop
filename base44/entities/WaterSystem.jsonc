{
  "name": "WaterSystem",
  "type": "object",
  "description": "A small community water system the operator runs. Holds the service-line inventory totals used for readiness, replacement targets, annual notices and state filings. Shared with the owner's team; personal (team_id null) records are private to their creator.",
  "properties": {
    "team_id": {
      "type": "string",
      "title": "Team ID",
      "description": "Team that owns this record. Null for a personal record, visible only to its creator. Set on create; only server functions move records between teams.",
      "rls": {
        "create": true,
        "update": false
      }
    },
    "name": {
      "type": "string",
      "title": "System Name",
      "minLength": 1,
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "client_emails": {
      "type": "string",
      "title": "Client Contacts",
      "description": "Email addresses of the system's owner, board or manager, separated by commas. Reports are emailed here.",
      "maxLength": 1000,
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "state": {
      "type": "string",
      "title": "State",
      "description": "Two-letter primacy state code, e.g. OH.",
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "pwsid": {
      "type": "string",
      "title": "PWS ID",
      "description": "Public water system ID, e.g. OH2140117.",
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "population": {
      "type": "number",
      "title": "Population Served",
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "field_tech": {
      "type": "string",
      "title": "Field Tech / Contact",
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "lead_count": {
      "type": "number",
      "title": "Lead Lines",
      "default": 0
    },
    "grr_count": {
      "type": "number",
      "title": "Galvanized Requiring Replacement",
      "default": 0
    },
    "unknown_count": {
      "type": "number",
      "title": "Unknown Material",
      "default": 0
    },
    "nonlead_count": {
      "type": "number",
      "title": "Non-lead Lines",
      "default": 0
    },
    "connectors_inventoried": {
      "type": "boolean",
      "title": "Lead Connectors Inventoried",
      "default": false,
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "plan_drafted": {
      "type": "boolean",
      "title": "Replacement Plan Drafted",
      "default": false,
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "last_notice_date": {
      "type": "string",
      "format": "date",
      "title": "Last Annual Notice Sent"
    },
    "replacements_scheduled": {
      "type": "number",
      "title": "Replacements Scheduled (Year 1)",
      "default": 0,
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "replacements_completed": {
      "type": "number",
      "title": "Replacements Completed",
      "default": 0,
      "description": "Lead and GRR service lines fully replaced since the compliance date (cumulative). Counts toward the 10% a year replacement rate.",
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    },
    "is_example": {
      "type": "boolean",
      "title": "Example Data",
      "default": false,
      "rls": {
        "update": {
          "$or": [
            {
              "data.team_id": null
            },
            {
              "user_condition": {
                "data.team_role": "owner"
              }
            },
            {
              "user_condition": {
                "data.perm_edit": true
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "name",
    "state"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.team_id": "{{user.data.team_id}}"
            },
            {
              "data.team_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "$and": [
                {
                  "data.team_id": "{{user.data.team_id}}"
                },
                {
                  "data.team_id": {
                    "$ne": null
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.team_role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "data.perm_write": true
                  }
                },
                {
                  "user_condition": {
                    "data.perm_edit": true
                  }
                }
              ]
            }
          ]
        },
        {
          "data.team_id": null
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$and": [
                {
                  "data.team_id": "{{user.data.team_id}}"
                },
                {
                  "data.team_id": {
                    "$ne": null
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.team_role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "data.perm_edit": true
                  }
                },
                {
                  "user_condition": {
                    "data.perm_write": true
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "$and": [
                {
                  "data.team_id": "{{user.data.team_id}}"
                },
                {
                  "data.team_id": {
                    "$ne": null
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.team_role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "data.perm_edit": true
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.team_id": null
            }
          ]
        }
      ]
    }
  }
}
