{
  "name": "Regulation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Regulation"
    },
    "agency": {
      "type": "string",
      "title": "Agency"
    },
    "reference_code": {
      "type": "string",
      "title": "Reference / citation"
    },
    "jurisdiction": {
      "type": "string",
      "title": "Jurisdiction",
      "enum": [
        "federal",
        "state",
        "local",
        "international"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "gray"
      ],
      "default": "federal"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "monitor",
        "assess",
        "action_required",
        "in_progress",
        "compliant",
        "not_applicable"
      ],
      "enumColors": [
        "gray",
        "blue",
        "red",
        "yellow",
        "green",
        "gray"
      ],
      "default": "monitor"
    },
    "risk": {
      "type": "string",
      "title": "Risk level",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "red"
      ],
      "default": "medium"
    },
    "industries": {
      "type": "array",
      "title": "Applies to industries",
      "items": {
        "type": "string",
        "enum": [
          "energy",
          "manufacturing",
          "construction",
          "agriculture"
        ]
      }
    },
    "owner": {
      "type": "string",
      "title": "Owner"
    },
    "effective_date": {
      "type": "string",
      "title": "Effective date",
      "format": "date"
    },
    "deadline": {
      "type": "string",
      "title": "Compliance deadline",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "title": "Summary"
    },
    "requirements": {
      "type": "string",
      "title": "Key requirements"
    },
    "source_url": {
      "type": "string",
      "title": "Source link"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}