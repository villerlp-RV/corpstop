{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "team_id": {
      "type": "string",
      "title": "Team ID",
      "description": "The team this user belongs to. Null for a personal account. Set only by server functions (create, join, leave, remove).",
      "rls": {
        "write": false
      }
    },
    "team_role": {
      "type": "string",
      "title": "Team Role",
      "enum": [
        "owner",
        "member"
      ],
      "description": "Owner manages the team's members and invite code.",
      "rls": {
        "write": false
      }
    },
    "perm_read": {
      "type": "boolean",
      "title": "Can Read",
      "description": "Download reports, replacement plans and exports. Set only by the team owner through a server function.",
      "rls": {
        "write": false
      }
    },
    "perm_write": {
      "type": "boolean",
      "title": "Can Write",
      "description": "Add new records and record field visits on lines assigned to them. Set only by the team owner through a server function.",
      "rls": {
        "write": false
      }
    },
    "perm_edit": {
      "type": "boolean",
      "title": "Can Edit",
      "description": "Change or delete existing records, assign field work and add photos. Set only by the team owner through a server function.",
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}
