{
  "name": "Activity",
  "type": "object",
  "properties": {
    "regulation_id": {
      "type": "string",
      "title": "Regulation"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "note",
        "update",
        "inspection",
        "filing",
        "status_change"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "yellow",
        "green"
      ]
    },
    "summary": {
      "type": "string",
      "title": "Summary"
    },
    "occurred_at": {
      "type": "string",
      "title": "When",
      "format": "date-time"
    }
  },
  "required": [
    "regulation_id",
    "summary"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}